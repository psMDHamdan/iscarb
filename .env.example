# ─── Lecture Ingestion — Object Storage + OCR sidecar (TASK-02) ───
LECTURE_STORAGE_BUCKET=iscarb-lecture-files
LECTURE_STORAGE_REGION=me-central-1
# Set these to real credentials for live uploads (uncomment):
# LECTURE_STORAGE_ACCESS_KEY=
# LECTURE_STORAGE_SECRET_KEY=
LECTURE_STORAGE_PREFIX=lecture
LECTURE_OCR_URL=http://localhost:8765/ocr

# ─── Exam content source ────────────────────────────────────────────────
# true  = REAL per-student AI generation. On Vercel the generation runs as a
#         durable QStash job (survives serverless lifecycle — see QStash vars
#         below); in dev it runs in-process. Signup prewarms it, so by the
#         time the student opens the exam it is usually already ready.
# false = serve the 47 questions INSTANTLY from the published Question Bank
#         (universal + specialty Job-Fit), catalog fallback for gaps. No AI at
#         exam time -> instant load. Use only if you accept bank content.
EXAM_LIVE_GENERATION=true

# Modules per queued exam-generation job. Default 8 → 6 jobs for 47 questions,
# each staying under Vercel Hobby's 60s function cap. Lower it (4–6) if
# individual questions are slow on Hobby.
EXAM_GENERATE_CHUNK_SIZE=8

# ═══════════════════════════════════════════════════════════════════════════════
#  VERCEL + SUPABASE DEPLOYMENT (faculty lecture pipeline)
# ═══════════════════════════════════════════════════════════════════════════════
#
# DATABASE_URL (Supabase) — use the TRANSACTION POOLER URL (port 6543), NOT the
# direct connection string. db.ts auto-detects *.pooler.supabase.com and sets
# pgbouncer=true + connection_limit=1. Format:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# DIRECT_URL — direct connection (port 5432) used for prisma migrate only.
#   postgresql://postgres.<project-ref>:<password>@db.<region>.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:iscarb_dev_password@127.0.0.1:5432/iscarb"
DIRECT_URL="postgresql://postgres:iscarb_dev_password@127.0.0.1:5432/iscarb"

# Redis (Upstash) — the RESP/TLS endpoint, not the REST URL. Format:
#   rediss://default:<UPSTASH_TOKEN>@<region>.upstash.io:6379
# Local dev default only; on Vercel set REDIS_URL to your Upstash rediss:// URL.
# If Redis is unreachable, rate limiting and session revocation degrade to
# fast in-memory fallbacks (200ms) — the app stays fast, just not distributed.
REDIS_URL="redis://localhost:6379"

# QStash (Upstash background jobs) — faculty generation/plan/parse run as
# queued jobs so they survive Vercel serverless lifecycle.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# Public URL of this deployment (used as the QStash callback base). On Vercel
# this is auto-derived from VERCEL_URL — only needed for local QStash testing.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Generation chunk size (slides per queued job). Default 4 → 5 jobs for a
# 20-slide lecture, each staying under Vercel Hobby's 60s function cap.
# Lower it (2–3) if individual slide generation is slow on Hobby.
LECTURE_GENERATE_CHUNK_SIZE=4

# RDF / Fuseki — do NOT set on Vercel. The Fuseki triple store cannot run on
# serverless; leaving FUSEKI_URL unset disables the RDF sync layer gracefully.
# FUSEKI_URL=
