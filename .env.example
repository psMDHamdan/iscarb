# =============================================================================
# iSCARB — Environment template (placeholders only — NO real secrets)
# Copy to `.env.production` on the VM or inject via your secret manager.
# For local Docker Compose dev: copy to `.env` and use port 5433 / 6380.
# =============================================================================

# ─── Core runtime ───────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
# Public URL of this deployment (links, callbacks, sitemap)
NEXT_PUBLIC_APP_URL=https://app.example.edu.sa

# ─── PostgreSQL (required) ──────────────────────────────────────────────────
# Production: Cloud SQL / managed Postgres in Dammam with pgvector enabled.
# Add pool params if needed: ?connection_limit=10&pool_timeout=20
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/iscarb
# Direct connection for `prisma migrate deploy` only (same host, no pooler)
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/iscarb

# ─── Redis (required) ───────────────────────────────────────────────────────
# Production: Memorystore or self-managed Redis in Dammam.
# TLS example: rediss://default:TOKEN@redis-host:6379
REDIS_URL=redis://HOST:6379
# REDIS_PASSWORD=   # optional if not embedded in REDIS_URL

# ─── Authentication & sessions (required in production) ───────────────────────
# RS256 JWT keys — generate a fresh keypair per environment.
# Multi-line PEM: use \n escapes or mount via JWT_PRIVATE_KEY_FILE / JWT_PUBLIC_KEY_FILE
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
# Legacy HS256 fallback (env.mjs only — prefer JWT RS256 keys above)
ISCARB_JWT_SECRET=replace-with-min-32-char-random-string-for-legacy-paths
# Password reset HMAC secret (min 32 chars — PasswordService fails closed without it)
PASSWORD_RESET_SECRET=replace-with-min-32-char-random-string
# Certificate credential ID hashing (min 16 chars in production validation)
CERTIFICATE_ID_SECRET=replace-with-random-string
# MUST be false in production (auth.ts enforces fail-closed regardless)
ISCARB_AUTH_DISABLED=false
# Comma-separated API keys for machine-to-machine access (optional)
# ISCARB_API_KEYS=key1,key2
ISCARB_DEFAULT_UNIVERSITY=KFU

# ─── NVIDIA / AI inference (required for AI features) ───────────────────────
# Primary key — additional keys enable parallel lecture slide generation
NVIDIA_API_KEY=nvapi-REPLACE_ME
# NVIDIA_API_KEY_2=
# NVIDIA_API_KEY_3=
# NVIDIA_API_KEY_4=
# NVIDIA_API_KEY_5=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_CHAT_MODEL=openai/gpt-oss-20b
# Assessment models
EXAM_LIVE_GENERATION=false
EXAM_LIVE_GENERATION_MODEL=openai/gpt-oss-20b
EXAM_SCORING_MODEL=openai/gpt-oss-20b
EXAM_KEY_VERIFY_MODEL=
SIGNUP_JOBFIT_MODEL=openai/gpt-oss-20b
# Concurrency / quotas
AI_CONCURRENCY_MAX=5
AI_QUOTA_DAILY=1000
AI_QUOTA_BURST=30
AI_QUOTA_CONCURRENT=5
AI_MAX_INPUT_TOKENS=16000
AI_MAX_OUTPUT_TOKENS=4096
AI_CACHE_TTL=3600
# AI_CACHE_DISABLED=true
# AI_COALESCING_DISABLED=true
NVIDIA_VLM_MODEL=

# ─── Object storage — in-Kingdom bucket (required in production) ─────────────
# Set region to your Dammam / KSA bucket (e.g. me-central2 for GCS).
# For GCS S3 interoperability, set LECTURE_STORAGE_ENDPOINT and FORCE_PATH_STYLE.
LECTURE_STORAGE_BUCKET=iscarb-lecture-files
LECTURE_STORAGE_REGION=me-central2
# LECTURE_STORAGE_ENDPOINT=https://storage.googleapis.com
# LECTURE_STORAGE_FORCE_PATH_STYLE=true
LECTURE_STORAGE_ACCESS_KEY=REPLACE_ME
LECTURE_STORAGE_SECRET_KEY=REPLACE_ME
LECTURE_STORAGE_PREFIX=lecture
# LECTURE_STORAGE_LOCAL_DIR=.lecture-storage   # dev-only fallback

# ─── Email (optional — password reset / notifications) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="iSCARB <no-reply@example.edu.sa>"

# ─── Web push (optional) ────────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@example.edu.sa

# ─── Observability (optional) ───────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=iscarb@1.0.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=iscarb-api
LOG_LEVEL=info

# ─── RDF / Fuseki (optional — disable by leaving unset) ───────────────────────
# FUSEKI_URL=http://fuseki-host:3030/iscarb
# FUSEKI_ADMIN_URL=http://fuseki-host:3030
# FUSEKI_ENDPOINT=http://fuseki-host:3030
# FUSEKI_DATASET=iscarb
# FUSEKI_TIMEOUT_MS=30000
# RDF_SPARQL_ENDPOINT=http://fuseki-host:3030/iscarb/query
# SPARQL_ENDPOINT=

# ─── Vector / pgvector (optional tuning) ─────────────────────────────────────
PGVECTOR_ENABLED=true
VECTOR_DIMENSION=1024
OPENAI_EMBEDDING_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2
VECTOR_SIMILARITY_THRESHOLD=0.7
VECTOR_MAX_RESULTS=20
VECTOR_BATCH_SIZE=50
VECTOR_EMBEDDINGS_OPTIONAL=true

# ─── Lecture pipeline tuning (optional) ─────────────────────────────────────
LECTURE_GENERATE_CHUNK_SIZE=4
LECTURE_BATCH_SIZE=20
LECTURE_OCR_URL=
LECTURE_MALWARE_SCAN_URL=
LECTURE_CLAMSCAN_BIN=

# ─── Assessment tuning (optional) ─────────────────────────────────────────────
EXAM_GENERATE_CHUNK_SIZE=8
EXAM_PREPARE_CONCURRENCY=5
ASSESSMENT_PERCENTILE_MIN_SAMPLE=

# ─── OIDC / enterprise SSO (optional) ───────────────────────────────────────
# OIDC_ISSUER_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=

# ─── Supabase (optional — only if using Supabase client paths) ────────────────
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# ─── AWS Secrets Manager (optional) ───────────────────────────────────────────
# AWS_REGION=me-central-1

# ─── Legacy / unused in current auth path ─────────────────────────────────────
# NEXTAUTH_SECRET=         # not referenced outside env.mjs
# NEXTAUTH_URL=
# IMPERSONATION_JWT_SECRET # not referenced in current codebase

# ─── Unused — do not set on VM/Docker deploy ──────────────────────────────────
# QStash was sketched for a serverless path that we are NOT using.
# Lecture jobs run in-process on the long-lived Node process (see src/lib/lecture/queue.ts).
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=

# ─── Release identity (reported by GET /api/health as commitSha) ──────────────
# GIT_COMMIT_SHA=          # set at image build / PM2 start (git rev-parse HEAD)

# ─── Docker build only ───────────────────────────────────────────────────────
# IS_DOCKER=true           # set during `npm run build:docker` / Docker build stage

# ─── Local Docker Compose overrides (dev) ─────────────────────────────────────
# DATABASE_URL=postgresql://postgres:iscarb_dev_password@127.0.0.1:5433/iscarb
# REDIS_URL=redis://127.0.0.1:6380
# SKIP_ENV_VALIDATION=true # local smoke only — never in real production
