DATABASE_URL="postgresql://postgres:iscarb_dev_password@127.0.0.1:5432/iscarb"
# Database (Docker container on port 5433 to avoid conflict with local Postgres on 5432)


# Redis (Docker container on port 6380 to avoid conflict with local Redis on 6379)
REDIS_URL="redis://localhost:6379"

# App
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
PORT=3000
HOST=localhost

# Auth (optional for dev)
NEXTAUTH_SECRET=dev-secret-key-change-in-production
NEXTAUTH_URL=http://localhost:3000

# JWT Configuration
ISCARB_JWT_SECRET=your-secret-key-change-in-production-min-32-chars-1234567890ab

# AI Configuration
OPENAI_API_KEY=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
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_CHAT_MODEL=openai/gpt-oss-20b
# ─── Exam AI models (employability assessment) ───────────────────────
# Generation: fast small Llama on NVIDIA. Questions still pass the 9-check
# validator + quality gate (failed ones retry). Swap to a larger model
# (e.g. meta/llama-3.3-70b-instruct) only if quality drops.
EXAM_LIVE_GENERATION_MODEL=meta/llama-3.1-8b-instruct
# Scoring: one fast call per answered module at finish. Small = quick results.
EXAM_SCORING_MODEL=meta/llama-3.1-8b-instruct
# Concurrency cap for ALL AI calls (default 5 = one per NVIDIA key). Do NOT
# raise above 5 — historically 8-10 caused 429 rate-limit spikes.
AI_CONCURRENCY_MAX=15


