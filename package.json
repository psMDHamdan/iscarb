  "packageManager": "npm@10.8.2",
  "scripts": {
    "dev": "next dev --turbo -p ${PORT:-3000}",
    "build": "NODE_ENV=production NODE_OPTIONS=--max-old-space-size=8192 next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint .",
    "db:push": "prisma db push && prisma generate",
    "db:generate": "prisma generate",
    "db:sync": "prisma db push && prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:reset": "prisma migrate reset",
    "db:seed": "npx tsx scripts/seed-production.ts",
    "db:seed:dev": "npx tsx scripts/seed.ts",
    "db:clean": "npx tsx scripts/clean-db.ts",
    "db:seed:history": "npx tsx scripts/seed-history.ts",
    "db:seed:assessment": "bun scripts/seed-assessment.ts",
    "db:seed:classifications": "bun scripts/seed-classifications.ts",
    "db:seed:question-bank": "npx tsx --require ./docs/_stub_server_only_register.cjs scripts/seed-question-bank.ts",
    "test:assessment-security-live": "npx tsx scripts/test-assessment-security-live.ts",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "postinstall": "prisma generate",
    "prepare": "echo 'husky disabled'"
  },
