model Role {
  id                           String                  @id @default(cuid())
  organizationId               String?
  name                         String
  description                  String?
  color                        String?                 @db.VarChar(7)
  icon                         String?
  displayOrder                 Int                     @default(0)
  isSystem                     Boolean                 @default(false)
  parentRoleId                 String?
  inheritsPermissions          Boolean                 @default(true)
  status                       String                  @default("active")
  deprecatedAt                 DateTime?
  deprecationReason            String?
  deprecationAlternativeRoleId String?
  allowsBulkAssignment         Boolean                 @default(true)
  maxConcurrentAssignments     Int?
  createdAt                    DateTime                @default(now())
  createdBy                    String?
  updatedAt                    DateTime                @updatedAt
  deletedAt                    DateTime?
  updatedBy                    String?
  dynamicRoles                 DynamicRoleAssignment[]
  creator                      User?                   @relation("RoleCreator", fields: [createdBy], references: [id])
  parentRole                   Role?                   @relation("RoleHierarchy", fields: [parentRoleId], references: [id])
  childRoles                   Role[]                  @relation("RoleHierarchy")
  updater                      User?                   @relation("RoleUpdater", fields: [updatedBy], references: [id])
  rolePermissions              RolePermissions[]
  userRoles                    UserRole[]
  permissions                  Permission[]            @relation("RolePermissions")

  @@unique([name, organizationId])
  @@index([name])
  @@index([organizationId])
  @@index([parentRoleId])
}

