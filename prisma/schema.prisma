// ─────────────────────────────────────────────────────────────────────────────
// CANONICAL LEARNING EXPERIENCE ARCHITECTURE (M1 DECOUPLED MODELS)
// ─────────────────────────────────────────────────────────────────────────────

/// Aggregate Root for the decoupled pedagogical learning experience.
/// Completely separates canonical learning concepts from 20-slide presentations.
model LearningExperience {
  id                    String                   @id @default(cuid())
  organizationId        String?
  organization          Organization?            @relation(fields: [organizationId], references: [id])
  tenantId              String                   // University-level isolation
  projectId             String
  version               Int                      @default(1)
  status                String                   @default("draft")
  // draft | review | approved | published | archived | superseded
  title                 String
  topicDescription      String?                  @db.Text
  targetAudience        String?
  languagePolicy        String                   @default("en") // en | ar | bilingual
  bloomLevel            String                   @default("apply")
  estimatedDurationMin  Int                      @default(50)
  pedagogicalFramework  String                   @default("iSCARB_7_STAGE")
  contentHash           String?                  // SHA-256 hash of entire canonical experience graph
  publishedAt           DateTime?
  publishedBy           String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  project               LectureProject           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  blueprint             LearningBlueprint?
  conceptBlocks         ConceptBlock[]
  activities            LearningActivity[]
  assessments           AssessmentItem[]
  visuals               VisualArtifact[]
  guide                 ExperienceGuide?
  evidenceReferences    EvidenceReference[]
  gateResults           ExperienceGateResult[]
  exports               ExperienceExport[]
  studentSessions       StudentExperienceSession[]

  @@unique([projectId, version])
  @@index([projectId, status])
  @@index([tenantId])
  @@index([organizationId])
}

/// 7-Stage Pedagogical Journey Plan & Cognitive Progression Blueprint
model LearningBlueprint {
  id                    String             @id @default(cuid())
  experienceId          String             @unique
  narrativeArc          String             @db.Text
  learningOutcomes      Json               // CourseLearningOutcome[]
  stagePlanJson         Json               // 7 journey stages: [{ stageKey, title, goal, conceptBlockIds, durationMin }]
  prerequisiteGraph     Json?              // DAG: { nodes: [], edges: [{ from, to, relationship }] }
  pacingStrategy        Json?              // { totalDuration, checkpoints: [] }
  structuralReviewScore Float?
  isApproved            Boolean            @default(false)
  approvedBy            String?
  approvedAt            DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  experience            LearningExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

/// Core Pedagogical Concept Block containing the 5-layer instructional depth:
/// Layer 1: Academic Truth, Layer 2: Mental Model, Layer 3: Mechanism,
/// Layer 4: Real-World Transfer, Layer 5: Misconception Alert.
model ConceptBlock {
  id                    String               @id @default(cuid())
  experienceId          String
  orderIndex            Int                  // 1-based sequential order in journey
  slug                  String               // e.g. "singular-value-decomposition-mechanics"
  title                 String
  titleAr               String?
  stageCategory         String               // discover | understand | explore | practice | apply | challenge | master
  bloomLevel            String               // remember | understand | apply | analyze | evaluate | create
  cloIds                String[]             // Mapped faculty CLO IDs
  sourceBlockIds        String[]             // Grounding source block IDs

  // 5-Layer Pedagogical Depth
  academicTruth         String               @db.Text
  intuitionMentalModel  String               @db.Text
  mechanismExplanation  String               @db.Text
  realWorldTransfer     String               @db.Text
  misconceptionAlert    String               @db.Text

  // Pedagogical Metadata
  coreIdea              String               @db.Text
  keyTakeaways          String[]
  keywords              String[]
  estimatedMinutes      Int                  @default(7)

  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  experience            LearningExperience   @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  activities            LearningActivity[]
  assessments           AssessmentItem[]
  visuals               VisualArtifact[]
  evidenceReferences    EvidenceReference[]
  studentInteractions   StudentBlockInteraction[]

  @@unique([experienceId, orderIndex])
  @@index([experienceId, stageCategory])
}

/// Interactive Student Cognitive Checkpoint
model LearningActivity {
  id                       String             @id @default(cuid())
  experienceId             String
  conceptBlockId           String
  activityType             String             // PREDICT | TEACH_IT_BACK | ACTIVE_RECALL | WORKED_EXAMPLE | GUIDED_DISCUSSION | CALCULATION_LAB | PEER_POLL
  title                    String
  prompt                   String             @db.Text
  promptAr                 String?            @db.Text
  actionVerb               String             // Predict, Calculate, Analyze, Contrast, Explain
  scaffoldingLevel         String             @default("guided") // guided | fading | independent
  initialContext           Json?              // Setup parameters, code snippet, or starting data
  expectedResponseCriteria Json?              // [{ criterion, weight, rubricDescriptor }]
  modelAnswer              String?            @db.Text
  progressiveHints         String[]           // Escalating hints [Level 1, Level 2, Level 3]
  misconceptionTriggers    Json?              // [{ triggerPhrase, diagnosisMessage, repairGuidance }]
  orderIndex               Int                @default(1)
  createdAt                DateTime           @default(now())

  experience               LearningExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  conceptBlock             ConceptBlock       @relation(fields: [conceptBlockId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@index([conceptBlockId, activityType])
}

/// Cognitively demanding academic assessment item with diagnostic misconception distractors.
/// Enforces Hidden Answer Architecture (rationales visible only to faculty/coach).
model AssessmentItem {
  id                     String             @id @default(cuid())
  experienceId           String
  conceptBlockId         String?
  assessmentType         String             // FORMATIVE_CHECK | DIAGNOSTIC_MCQ | TRANSFER_CHALLENGE | CAPSTONE_CASE
  bloomLevel             String             // understand | apply | analyze | evaluate
  difficulty             String             @default("medium") // easy | medium | hard | expert
  stem                   String             @db.Text
  stemAr                 String?            @db.Text
  options                Json               // Exactly 4 options: [{ id: "A", text: string, textAr?: string, isCorrect: boolean, misconceptionKey?: string }]
  correctOptionId        String             // "A" | "B" | "C" | "D"
  instructorRationale    String             @db.Text // Faculty/AI Coach rationale (Hidden from student deck)
  distractorExplanations Json?              // { "A": "...", "B": "...", "C": "...", "D": "..." }
  cloId                  String?
  orderIndex             Int                @default(1)
  isFinalGate            Boolean            @default(false)
  createdAt              DateTime           @default(now())

  experience             LearningExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  conceptBlock           ConceptBlock?      @relation(fields: [conceptBlockId], references: [id], onDelete: SetNull)

  @@index([experienceId, isFinalGate])
  @@index([conceptBlockId])
}

/// Explanatory visual specification powered by 4-tier asset resolution.
model VisualArtifact {
  id                    String             @id @default(cuid())
  experienceId          String
  conceptBlockId        String?
  visualType            String             // PROCESS | SYSTEM_ARCHITECTURE | DATA_FLOW | COMPARISON_MATRIX | CAUSE_EFFECT | QUANTITATIVE | HIERARCHY
  title                 String
  purpose               String             @db.Text
  learningMessage       String             @db.Text
  specificationJson     Json               // VisualSpecification { layout, elements, connections, labels, annotations, studentFocusQuestion }
  
  // 4-Tier Asset Resolution Strategy
  assetSourceTier       String             // SOURCE_DOCUMENT | ACADEMIC_SEARCH | AI_SYNTHESIS | SEMANTIC_TEMPLATE
  primaryAssetUrl       String?
  vectorSvgCode         String?            @db.Text
  thumbnailUrl          String?
  licenseType           String?            // Creative Commons, Public Domain, Fair Use Academic
  attributionText       String?
  
  orderIndex            Int                @default(1)
  createdAt             DateTime           @default(now())

  experience            LearningExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  conceptBlock          ConceptBlock?      @relation(fields: [conceptBlockId], references: [id], onDelete: SetNull)

  @@index([experienceId])
  @@index([conceptBlockId])
}

/// Verifiable claim-to-source link grounding learning claims in source blocks.
model EvidenceReference {
  id                    String             @id @default(cuid())
  experienceId          String
  conceptBlockId        String
  sourceBlockId         String
  claimText             String             @db.Text
  claimType             String             // SOURCE_FACT | EXTERNAL_FACT | DERIVED | ILLUSTRATIVE | HYPOTHETICAL
  sourceLocator         String             // e.g. "slide:14", "page:102", "section:4.2"
  verbatimExcerpt       String             @db.Text
  verificationStatus    String             @default("VERIFIED") // VERIFIED | PARTIALLY_SUPPORTED | UNSUPPORTED | CONFLICTING
  confidenceScore       Float              @default(1.0)
  createdAt             DateTime           @default(now())

  experience            LearningExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  conceptBlock          ConceptBlock       @relation(fields: [conceptBlockId], references: [id], onDelete: Cascade)
  sourceBlock           LectureSourceBlock @relation(fields: [sourceBlockId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@index([conceptBlockId])
  @@index([sourceBlockId])
}

/// Dual-sided companion guide: Faculty Facilitation Script & Student Study Companion.
model ExperienceGuide {
  id                    String             @id @default(cuid())
  experienceId          String             @unique
  facultyGuideJson      Json               // { facilitationScript, pacingGuide: [], discussionPrompts: [], commonMisconceptions: [], solutionKeys: {} }
  studentCompanionJson  Json               // { executiveSummary, keyConcepts: [], reflectionQuestions: [], glossary: {}, furtherReading: [] }
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  experience            LearningExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId])
}

/// Quality gate check results across the 17 generation passes.
model ExperienceGateResult {
  id                    String             @id @default(cuid())
  experienceId          String
  passNumber            Int                // 1..17
  gateName              String             // blueprint_structure | pedagogical_depth | clo_coverage | assessment_rigor | fact_grounding | visual_value
  status                String             // PASS | SOFT_FAIL | HARD_FAIL | WAIVED
  score                 Float              // 0.0 - 100.0
  findingsJson          Json               // [{ severity: "error"|"warning", componentId, message, repairGuidance }]
  waivedBy              String?
  waiveReason           String?
  checkedAt             DateTime           @default(now())

  experience            LearningExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, passNumber])
}

/// Exported packages projected from the canonical learning experience.
model ExperienceExport {
  id                    String             @id @default(cuid())
  experienceId          String
  exportFormat          String             // PPTX | STUDENT_UX_JSON | QTI_ZIP | PDF_HANDOUT | NCAAA_PACK
  storageKey            String
  fileSize              Int
  mimeType              String
  downloadUrl           String?
  generatedAt           DateTime           @default(now())

  experience            LearningExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@index([experienceId, exportFormat])
}

// ─────────────────────────────────────────────────────────────────────────────
// STUDENT RUNTIME SESSION MODELS
// ─────────────────────────────────────────────────────────────────────────────

/// Active student learning session spanning the 7 pedagogical stages.
model StudentExperienceSession {
  id                    String                   @id @default(cuid())
  experienceId          String
  studentId             String
  currentBlockIndex     Int                      @default(1)
  currentStage          String                   @default("discover")
  completedStageKeys    String[]                 // ["discover", "understand", "explore", ...]
  xpScore               Int                      @default(0)
  masteryPercent        Float                    @default(0.0)
  startedAt             DateTime                 @default(now())
  completedAt           DateTime?
  lastActiveAt          DateTime                 @default(now())

  experience            LearningExperience       @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  student               Student                  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  interactions          StudentBlockInteraction[]

  @@unique([experienceId, studentId])
  @@index([studentId])
}

/// Granular student response to an interactive activity or assessment item.
model StudentBlockInteraction {
  id                    String                   @id @default(cuid())
  sessionId             String
  conceptBlockId        String
  activityType          String                   // PREDICT | TEACH_IT_BACK | ACTIVE_RECALL | MCQ_ANSWER
  studentInput          String                   @db.Text
  selectedOptionId      String?
  isCorrect             Boolean?
  confidenceLevel       String?                  // guessing | somewhat_confident | completely_sure
  aiCoachFeedback       String?                  @db.Text
  hintsRequested        Int                      @default(0)
  evaluatedMasteryScore Float?
  timeSpentSeconds      Int                      @default(0)
  createdAt             DateTime                 @default(now())

  session               StudentExperienceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  conceptBlock          ConceptBlock             @relation(fields: [conceptBlockId], references: [id], onDelete: Cascade)

  @@index([sessionId, conceptBlockId])
}
