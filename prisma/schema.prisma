generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Course {
  id                       String                    @id @default(cuid())
  code                     String                    @unique
  name                     String
  nameAr                   String?
  credits                  Int                       @default(3)
  programType              String
  nqfLevel                 Int
  bloomTarget              String
  domains                  String
  universityId             String?
  createdAt                DateTime                  @default(now())
  universityRef            University?               @relation(fields: [universityId], references: [id])
  concepts                 CourseConcept[]
  enrollments              Enrollment[]
  grades                   Grade[]
  units                    Unit[]
  adaptiveDifficultyLevels AdaptiveDifficultyLevel[]
  aiTutoringSessions       AITutoringSession[]
}

model Unit {
  id          String       @id @default(cuid())
  courseId    String
  title       String
  content     String
  order       Int          @default(0)
  createdAt   DateTime     @default(now())
  aiPrompts   AiPrompt[]
  simulations Simulation[]
  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model AiPrompt {
  id           String   @id @default(cuid())
  unitId       String?
  stage        String
  modelTag     String
  systemPrompt String
  userTemplate String
  temperature  Float    @default(0.4)
  createdAt    DateTime @default(now())
  unit         Unit?    @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@index([stage])
}

model University {
  id                  String               @id @default(cuid())
  code                String               @unique
  name                String
  nameAr              String?
  city                String?
  active              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  organizationId      String?
  courses             Course[]
  deanNotifications   DeanNotification[]
  faculty             Faculty[]
  facultyProfiles     FacultyProfile[]
  knowledgeBaseTopics KnowledgeBaseTopic[]
  reports             Report[]
  students            Student[]
  organization        Organization?        @relation(fields: [organizationId], references: [id])
  users               User[]
  workflows           Workflow[]

  @@index([organizationId])
}

model Student {
  id                          String                       @id @default(cuid())
  name                        String
  email                       String                       @unique
  university                  String                       @default("KFU")
  universityId                String?
  college                     String
  program                     String
  cohort                      String
  guardianName                String?
  guardianPhone               String?
  readinessScore              Int                          @default(0)
  discoverable                Boolean                      @default(false)
  scedSpecializationCode      String?
  educationLevelCode          String?                      @default("6")
  createdAt                   DateTime                     @default(now())
  userId                      String?                      @unique
  guardianConsentAt           DateTime?
  aiOnboardingComplete        Boolean                      @default(false)
  targetCareerName            String?
  targetCareerUri             String?
  lastAIBriefing              DateTime?
  totalStudyHours             Int                          @default(0)
  currentStreak               Int                          @default(0)
  aiexplainRequests           AIExplainRequest[]
  grades                      Grade[]
  aigeneratedQuizs            AIGeneratedQuiz[]
  ailearningInsights          AILearningInsight[]
  aiRecommendations           AIRecommendation[]
  aistudyRecommendations      AIStudyRecommendation[]
  academicTranscripts         AcademicTranscript[]
  activeParticipation         ActiveParticipation[]
  alumniConnections           AlumniConnection[]
  assessmentResponses         AssessmentResponse[]
  assessmentSnapshots         AssessmentSnapshot[]
  assessmentAttempts          AssessmentAttempt[]
  attendance                  AttendanceRecord[]
  capstoneProjects            CapstoneProject[]
  aiInsights                  CareerAIInsight[]            @relation("StudentAIInsights")
  careerDevelopmentPlan       CareerDevelopmentPlan?       @relation("StudentCareerPlan")
  careerGoals                 CareerGoal[]
  careerIntelligenceSnapshots CareerIntelligenceSnapshot[]
  careerInterests             CareerInterest[]
  careerMappings              CareerMapping[]
  mockInterviews              CareerMockInterview[]        @relation("StudentMockInterviews")
  careerPaths                 CareerPath[]
  careerProfile               CareerProfile?
  resourceAccess              CareerResourceAccess[]       @relation("StudentResourceAccess")
  challengeTeams              ChallengeTeamMember[]
  competencyEvidence          CompetencyEvidence[]
  consentRecords              ConsentRecord[]
  digitalCredentials          DigitalCredential[]
  employabilityProfile        EmployabilityProfile?
  enrollments                 Enrollment[]
  equityLedger                EquityLedger?
  experiencePoints            ExperiencePoints[]
  flashcardDecks              FlashcardDeck[]
  fundingApplications         FundingApplication[]         @relation("StudentFunding")
  fundingSaves                FundingSave[]
  gradeAdjustments            GradeAdjustment[]
  graduationChecklist         GraduationChecklist?
  hackathonRegistrations      HackathonRegistration[]
  hackathonTeamMembers        HackathonTeamMember[]
  internships                 Internship[]
  interviewPrep               InterviewPrep?
  interviewSessions           InterviewSession[]
  issuedCredentials           IssuedCredential[]
  jobAlertSubscriptions       JobAlertSubscription[]       @relation("StudentJobAlerts")
  jobApplications             JobApplication[]             @relation("StudentApplications")
  jobMatches                  JobMatch[]
  jobOffers                   JobOffer[]
  knowledgeGaps               KnowledgeGap[]
  learningJourneys            LearningJourney[]
  learningMemories            LearningMemory[]
  learningStreak              LearningStreak?
  masteryPredictions          MasteryPrediction[]
  mentorshipSessions          MentorshipSession[]
  networkingEvents            NetworkingEvent[]            @relation("StudentNetworkingEvents")
  notifications               Notification[]
  pipelineStages              PipelineStage[]
  placement                   Placement?                   @relation("StudentPlacement")
  portfolio                   Portfolio?
  portfolioReviews            PortfolioReview[]
  productivitySessions        ProductivitySession[]
  professionalNetwork         ProfessionalNetwork[]        @relation("StudentNetwork")
  projects                    Project[]
  pushSubscriptions           PushSubscription[]
  r2cArtifacts                R2CArtifact[]
  readinessAssessments        ReadinessAssessment[]
  recruiterActivities         RecruiterActivity[]
  riskIndicators              RiskIndicator[]
  simulationScenarios         SimulationScenario[]
  skillExplorations           SkillExploration[]
  skillProgress               SkillProgress[]
  spacedRepetitionItems       SpacedRepetitionItem[]
  educationLevel              ScedField?                   @relation("StudentEducationLevel", fields: [educationLevelCode], references: [code])
  scedSpecialization          ScedField?                   @relation("StudentSpecialization", fields: [scedSpecializationCode], references: [code])
  universityRef               University?                  @relation(fields: [universityId], references: [id])
  authUser                    User?                        @relation(fields: [userId], references: [id])
  successAchievements         StudentAchievement[]
  agents                      StudentAgent[]
  studentBadges               StudentBadge[]
  studentEvents               StudentEvent[]
  successGoals                StudentGoal[]
  studentOnboarding           StudentOnboarding?
  successTasks                StudentTask[]
  studyPlans                  StudyPlan[]
  studyReminders              StudyReminder[]
  studySessions               StudySession[]
  coachSessions               SuccessCoachSession[]
  successMetrics              SuccessMetrics?
  talentPoolMembers           TalentPoolMember[]
  adaptiveDifficultyLevels    AdaptiveDifficultyLevel[]
  aiContentGenerations        AIContentGeneration[]
  aiInterventionCampaigns     AIInterventionCampaign[]
  aiTutoringSessions          AITutoringSession[]
  resumeAiReviews             ResumeAiReview[]
  learningProfile             StudentLearningProfile?
  studentExperienceSessions   StudentExperienceSession[]

  @@index([universityId, discoverable, readinessScore])
}

model Faculty {
  id                    String                 @id @default(cuid())
  name                  String
  email                 String                 @unique
  department            String
  rank                  String                 @default("Assistant Professor")
  universityId          String?
  createdAt             DateTime               @default(now())
  userId                String?                @unique
  enrollments           Enrollment[]
  universityRef         University?            @relation(fields: [universityId], references: [id])
  authUser              User?                  @relation(fields: [userId], references: [id])
  profile               FacultyProfile?
  knowledgeBaseArticles KnowledgeBaseArticle[]
}

model Enrollment {
  id           String   @id @default(cuid())
  courseId     String
  studentId    String?
  facultyId    String?
  semester     String   @default("2026-1")
  enrolledAt   DateTime @default(now())
  universityId String?
  course       Course   @relation(fields: [courseId], references: [id])
  faculty      Faculty? @relation(fields: [facultyId], references: [id])
  student      Student? @relation(fields: [studentId], references: [id])
  grade        Grade?

  @@index([universityId])
  @@index([courseId])
  @@index([studentId])
  @@index([facultyId])
}

model Grade {
  id           String      @id @default(cuid())
  studentId    String
  courseId     String
  enrollmentId String?     @unique
  semester     String
  letter       String      @default("-")
  gpa          Float       @default(0)
  percentage   Float?
  credits      Int         @default(0)
  status       String      @default("in-progress")
  createdAt    DateTime    @default(now())
  student      Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course       Course      @relation(fields: [courseId], references: [id])
  enrollment   Enrollment? @relation(fields: [enrollmentId], references: [id])

  @@unique([studentId, courseId, semester])
  @@index([studentId])
  @@index([courseId])
}

model AttendanceRecord {
  id           String   @id @default(cuid())
  studentId    String
  courseId     String
  sessionDate  DateTime
  status       String
  method       String   @default("physical")
  note         String?
  createdAt    DateTime @default(now())
  universityId String?
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([courseId])
  @@index([studentId])
}

model ActiveParticipation {
  id                 String   @id @default(cuid())
  studentId          String
  courseId           String
  unitId             String?
  interactionsCount  Int      @default(0)
  avgInputQuality    Float    @default(0)
  aiConfidence       Float    @default(0)
  promptsAccepted    Int      @default(0)
  peerEndorsements   Int      @default(0)
  promptQualityScore Float    @default(0)
  recordedAt         DateTime @default(now())
  universityId       String?
  student            Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([courseId])
  @@index([unitId])
  @@index([studentId])
}

model GradeAdjustment {
  id                  String    @id @default(cuid())
  studentId           String
  courseId            String
  facultyId           String
  oldGrade            Float
  newGrade            Float
  justificationReason String
  evidence            String
  status              String    @default("pending")
  approvedBy          String?
  deanNotified        Boolean   @default(false)
  createdAt           DateTime  @default(now())
  reviewedAt          DateTime?
  universityId        String?
  student             Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([courseId])
  @@index([facultyId])
  @@index([studentId])
}

model DeanNotification {
  id                 String      @id @default(cuid())
  universityId       String?
  courseId           String
  courseCode         String
  adjustmentId       String?
  sectionAdjustments Int
  sectionEnrolled    Int
  thresholdPct       Int
  message            String
  severity           String      @default("warning")
  acknowledged       Boolean     @default(false)
  acknowledgedBy     String?
  acknowledgedAt     DateTime?
  dispatchedAt       DateTime    @default(now())
  createdAt          DateTime    @default(now())
  universityRef      University? @relation(fields: [universityId], references: [id])
}

model Simulation {
  id              String   @id @default(cuid())
  unitId          String
  title           String
  context         String
  opening         String
  successCriteria String
  company         String
  role            String
  payload         String
  confidence      Float    @default(0)
  createdAt       DateTime @default(now())
  unit            Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
}

model Project {
  id             String    @id @default(cuid())
  studentId      String
  title          String
  type           String
  description    String
  skillsJson     String
  contentJson    String?
  evalScore      Float?
  evalConfidence Float?
  evalRubricJson String?
  evalModel      String?
  evaluatedAt    DateTime?
  artifactUrl    String?
  createdAt      DateTime  @default(now())
  universityId   String?
  student        Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([universityId])
  @@index([studentId])
}

model CareerMapping {
  id             String           @id @default(cuid())
  studentId      String
  generatedTitle String
  titleAr        String?
  cluster        String
  sscoCode       String?
  iscoMajorGroup String?
  alignment      String
  matchScore     Float
  skillsEvidence String
  createdAt      DateTime         @default(now())
  ssco           SsccoOccupation? @relation(fields: [sscoCode], references: [code])
  student        Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model StudentAgent {
  id         String                @id @default(cuid())
  studentId  String
  name       String
  persona    String
  state      String
  lastNudge  String?
  streakDays Int                   @default(0)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt
  student    Student               @relation(fields: [studentId], references: [id], onDelete: Cascade)
  messages   StudentAgentMessage[]
}

model Challenge {
  id         String          @id @default(cuid())
  company    String
  sector     String
  title      String
  brief      String
  difficulty String          @default("intermediate")
  skillsJson String
  reward     String?
  deadline   DateTime?
  status     String          @default("open")
  createdAt  DateTime        @default(now())
  teams      ChallengeTeam[]
}

model ChallengeTeam {
  id          String                @id @default(cuid())
  challengeId String
  name        String
  submission  String?
  score       Float?
  createdAt   DateTime              @default(now())
  challenge   Challenge             @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  members     ChallengeTeamMember[]
}

model ChallengeTeamMember {
  id        String        @id @default(cuid())
  teamId    String
  studentId String
  role      String        @default("member")
  student   Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  team      ChallengeTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
}

model MarketSignal {
  id          String   @id @default(cuid())
  employer    String
  sector      String
  skill       String
  demandIndex Int
  trend       String   @default("rising")
  rolesOpen   Int      @default(0)
  vision2030  Boolean  @default(false)
  capturedAt  DateTime @default(now())

  @@index([employer, skill, capturedAt])
}

model AssessmentModule {
  id             String   @id @default(cuid())
  code           String
  title          String
  dimension      String
  specialization String?
  level          String
  framework      String
  generated      Boolean  @default(false)
  rubricJson     String
  version        Int      @default(1)
  signOffState   String   @default("draft") // draft, pending, approved, rejected
  authorId       String?
  createdAt      DateTime @default(now())

  @@unique([code, specialization, version])
}

/// Employability exam Question Bank (Phase 1 — storage only).
/// Replaces orphaned `QuestionBank` in prisma_schema_additions.prisma (never migrated).
/// Distinct from Course OS `AssessmentQuestion` and faculty `GeneratedQuestion`.
/// `correctIndex` is server-side only — never expose via client APIs (see public-question-payload).
enum BankQuestionStatus {
  draft
  in_review
  approved
  published
  rejected
  archived
}

enum BankQuestionProvenance {
  curated
  pregenerated
  ai_generated
}

model EmployabilityBankQuestion {
  id             String                 @id @default(cuid())

  // Identity — aligns with catalog module codes (M01, JOBFIT-…, etc.)
  moduleCode     String
  dimension      String
  specialization String? // null = universal; set for Job-Fit specialty variants

  // Display / catalog metadata (optional; content can stand alone)
  title          String?
  titleAr        String?
  level          String?
  framework      String?
  focus          String?
  estimateMinutes Int?
  passThreshold  Float                  @default(70)

  // Content
  scenario       String                 @db.Text
  instructions   String                 @db.Text
  /// JSON string[] — exactly 4 MCQ choice texts (order matches correctIndex)
  choicesJson    String
  /// 0..3 index into choicesJson. SERVER-SIDE ONLY — strip before any client payload.
  correctIndex   Int

  // Rubric — full criteria (criterion, weight, descriptor, …) as JSON array
  rubricJson     String                 @db.Text

  // Lifecycle (gateways in later phases drive transitions)
  status         BankQuestionStatus     @default(draft)

  // Provenance
  provenance     BankQuestionProvenance
  /// SHA-256 hex of canonical content (moduleCode|specialization|scenario|instructions|choices|correctIndex|rubric)
  contentHash    String
  aiModelUsed    String?
  version        Int                    @default(1)

  /// Phase 5: auto-published AI Job-Fit still awaiting faculty human review.
  /// Exam serves status=published regardless; faculty queue filters this flag.
  needsHumanReview Boolean              @default(false)

  // Review metadata linkage (review workflow records land in a later phase)
  reviewedBy     String?
  reviewedAt     DateTime?
  reviewNotes    String?                @db.Text
  /// Soft link to a future review record; no FK in Phase 1
  reviewId       String?

  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([moduleCode, status])
  @@index([specialization, status])
  @@index([status])
  @@index([dimension, status])
  @@index([contentHash])
  @@index([provenance, status])
  @@index([needsHumanReview, status])
  @@unique([moduleCode, specialization, version])
}

model AssessmentResponse {
  id               String   @id @default(cuid())
  studentId        String
  moduleCode       String
  dimension        String
  specialization   String?
  score            Float
  band             String
  passed           Boolean
  perCriterionJson String
  feedback         String
  strengthsJson    String
  improvementsJson String
  validationPassed Boolean?
  model            String
  source           String
  rawResponse      String?
  latencyMs        Int      @default(0)
  isCurrent        Boolean  @default(true)
  createdAt        DateTime @default(now())
  universityId     String?
  // DR-07 cost-monitor fields (additive, all optional)
  tokensInput      Int?
  tokensOutput     Int?
  costUsd          Float?
  processingStatus String?
  student          Student                     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  validationReview AssessmentValidationReview?
  calibrationReviews AssessmentCalibrationReview[]

  @@index([studentId])
  @@index([studentId, moduleCode])
  @@index([universityId])
}

model AssessmentSnapshot {
  id        String   @id @default(cuid())
  studentId String
  dataJson  String
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model AssessmentAttempt {
  id               String   @id @default(cuid())
  studentId        String
  specialization   String
  status           String   @default("in_progress") // in_progress, completed
  blueprintJson    String   // Contains all generated scenarios, rubrics, question types
  answersJson      String   @default("{}") // Key-value map of moduleCode -> student's answer
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model AssessmentValidationReview {
  id              String             @id @default(cuid())
  responseId      String             @unique
  status          String             @default("pending") // pending, approved, overridden
  originalScore   Float
  originalBand    String
  overriddenScore Float?
  overriddenBand  String?
  facultyId       String?
  createdAt       DateTime           @default(now())
  resolvedAt      DateTime?
  response        AssessmentResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)

  @@index([status])
}

model AssessmentCalibrationReview {
  id             String             @id @default(cuid())
  responseId     String
  facultyId      String
  aiScore        Float
  facultyScore   Float
  absoluteError  Float
  createdAt      DateTime           @default(now())
  response       AssessmentResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  
  @@index([facultyId])
  @@index([responseId])
}

model EmployabilityProfile {
  id             String   @id @default(cuid())
  studentId      String   @unique
  specialization String?
  composite      Float
  band           String
  passed         Boolean
  dimensionsJson String
  coveredJson    String
  computedAt     DateTime @default(now())
  student        Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model ScedField {
  id                       String    @id @default(cuid())
  code                     String    @unique
  kind                     String
  nameEn                   String
  nameAr                   String
  parentCode               String?
  nqfLevel                 Int?
  iscedLevel               Int?
  coursesEn                String?
  coursesAr                String?
  createdAt                DateTime  @default(now())
  studentsByLevel          Student[] @relation("StudentEducationLevel")
  studentsBySpecialization Student[] @relation("StudentSpecialization")

  @@index([kind])
  @@index([parentCode])
}

model SsccoOccupation {
  id             String          @id @default(cuid())
  code           String          @unique
  kind           String
  nameEn         String
  nameAr         String
  parentCode     String?
  iscoCode       String?
  skillLevel     Int?
  createdAt      DateTime        @default(now())
  careerCards    CareerCard[]
  careerMappings CareerMapping[]
  jobPostings    JobPosting[]
  mentorProfiles MentorProfile[]

  @@index([kind])
  @@index([parentCode])
  @@index([iscoCode])
}

model EquityLedger {
  id              String        @id @default(cuid())
  studentId       String        @unique
  estimatedValue  Float         @default(0)
  equityScore     Int           @default(0)
  learningHours   Float         @default(0)
  projectsScore   Float         @default(0)
  challengesScore Float         @default(0)
  skillsCount     Int           @default(0)
  breakdownJson   String?
  updatedAt       DateTime      @updatedAt
  createdAt       DateTime      @default(now())
  universityId    String?
  events          EquityEvent[]
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([universityId])
}

model EquityEvent {
  id         String       @id @default(cuid())
  ledgerId   String
  source     String
  label      String
  valueDelta Float        @default(0)
  scoreDelta Int          @default(0)
  metaJson   String?
  createdAt  DateTime     @default(now())
  ledger     EquityLedger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@index([ledgerId])
  @@index([source])
}

model CareerPath {
  id              String        @id @default(cuid())
  studentId       String
  titleEn         String
  titleAr         String
  targetSscoCode  String?
  targetComposite Int           @default(80)
  rationaleEn     String?
  rationaleAr     String?
  source          String        @default("ai")
  model           String?
  createdAt       DateTime      @default(now())
  student         Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  stages          CareerStage[]

  @@index([studentId])
}

model CareerStage {
  id              String     @id @default(cuid())
  pathId          String
  order           Int
  titleEn         String
  titleAr         String
  focusEn         String?
  focusAr         String?
  activitiesJson  String
  targetComposite Int        @default(0)
  path            CareerPath @relation(fields: [pathId], references: [id], onDelete: Cascade)

  @@index([pathId])
}

model PortfolioReview {
  id               String   @id @default(cuid())
  studentId        String
  overallScore     Int
  strengthsJson    String
  gapsJson         String
  marketComparison String
  source           String   @default("ai")
  model            String?
  createdAt        DateTime @default(now())
  student          Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model JobPosting {
  id           String           @id @default(cuid())
  title        String
  titleAr      String?
  description  String?
  employer     String
  sector       String
  industry     String?
  sscoCode     String?
  minComposite Int              @default(0)
  skillsJson   String
  skills       Json?
  salaryMin    Float?
  salaryMax    Float?
  currency     String           @default("SAR")
  jobType      String?
  location     String?
  remote       Boolean          @default(false)
  vision2030   Boolean          @default(false)
  status       String           @default("active")
  views        Int              @default(0)
  source       String           @default("seed")
  externalId   String?
  postedAt     DateTime         @default(now())
  deadline     DateTime?
  closedAt     DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  recruiterId  String?
  applications JobApplication[]
  matches      JobMatch[]
  jobOffers    JobOffer[]
  recruiter    Recruiter?       @relation(fields: [recruiterId], references: [id])
  ssco         SsccoOccupation? @relation(fields: [sscoCode], references: [code])

  @@index([sscoCode])
  @@index([sector])
  @@index([recruiterId])
}

model JobMatch {
  id              String     @id @default(cuid())
  studentId       String
  jobId           String
  matchScore      Int
  sscoScore       Int
  compositeScore  Int
  skillsScore     Int
  vision2030Bonus Int
  breakdownJson   String?
  computedAt      DateTime   @default(now())
  job             JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)
  student         Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, jobId])
  @@index([studentId])
}

model FundingProgram {
