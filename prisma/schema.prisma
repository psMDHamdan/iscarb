  @@unique([assessmentId, studentId, attemptNumber])
  @@index([universityId, status])
  @@index([studentId, status])
  @@index([submissionToken])
}

model AssessmentQuestionResponse {
  id             String               @id @default(cuid())
  submissionId   String
  questionId     String
