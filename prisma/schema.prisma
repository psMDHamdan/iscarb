  @@index([universityId, status])
  @@index([createdBy])
}

model AssessmentQuestion {
  id                String                       @id @default(cuid())
  assessmentId      String
  order             Int
  type              String
  prompt            String
  instructionsJson  String?
  pointsPossible    Float                        @default(1)
