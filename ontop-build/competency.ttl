@prefix : <https://iscarb.edu/ontology/competency/> .
@prefix iscarb-competency: <https://iscarb.edu/ontology/competency/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Ontology Version 1.0.0 ###

### Class: SkillExploration
iscarb-competency:SkillExploration a owl:Class ;
  rdfs:label "SkillExploration" .

iscarb-competency:id a owl:DatatypeProperty ;
  rdfs:domain iscarb-competency:SkillExploration .

iscarb-competency:studentId a owl:DatatypeProperty ;
  rdfs:domain iscarb-competency:SkillExploration .

iscarb-competency:skillName a owl:DatatypeProperty ;
  rdfs:domain iscarb-competency:SkillExploration .

iscarb-competency:sscoCode a owl:DatatypeProperty ;
  rdfs:domain iscarb-competency:SkillExploration .

iscarb-competency:status a owl:DatatypeProperty ;
  rdfs:domain iscarb-competency:SkillExploration .

iscarb-competency:notes a owl:DatatypeProperty ;
  rdfs:domain iscarb-competency:SkillExploration .

iscarb-competency:discoveredAt a owl:DatatypeProperty ;
  rdfs:domain iscarb-competency:SkillExploration .

iscarb-competency:updatedAt a owl:DatatypeProperty ;
  rdfs:domain iscarb-competency:SkillExploration .

iscarb-competency:student a owl:ObjectProperty ;
  rdfs:domain iscarb-competency:SkillExploration ;
  rdfs:range <https://iscarb.edu/ontology/core/Student> .

