### Ontology Version 1.0.0 ###

### Class: CareerMapping
iscarb-career:CareerMapping a owl:Class ;
  rdfs:label "CareerMapping" .

iscarb-career:id a owl:DatatypeProperty ;
  rdfs:domain iscarb-career:CareerMapping .

iscarb-career:studentId a owl:DatatypeProperty ;
  rdfs:domain iscarb-career:CareerMapping .

iscarb-career:generatedTitle a owl:DatatypeProperty ;
  rdfs:domain iscarb-career:CareerMapping .

iscarb-career:titleAr a owl:DatatypeProperty ;
  rdfs:domain iscarb-career:CareerMapping .

iscarb-career:cluster a owl:DatatypeProperty ;
  rdfs:domain iscarb-career:CareerMapping .

iscarb-career:sscoCode a owl:DatatypeProperty ;
  rdfs:domain iscarb-career:CareerMapping .

iscarb-career:iscoMajorGroup a owl:DatatypeProperty ;
  rdfs:domain iscarb-career:CareerMapping .

iscarb-career:alignment a owl:DatatypeProperty ;
  rdfs:domain iscarb-career:CareerMapping .

iscarb-career:matchScore a owl:DatatypeProperty ;
  rdfs:domain iscarb-career:CareerMapping .

iscarb-career:skillsEvidence a owl:DatatypeProperty ;
  rdfs:domain iscarb-career:CareerMapping .

iscarb-career:createdAt a owl:DatatypeProperty ;
  rdfs:domain iscarb-career:CareerMapping .

iscarb-career:ssco a owl:ObjectProperty ;
  rdfs:domain iscarb-career:CareerMapping ;
  rdfs:range <https://iscarb.edu/ontology/core/SsccoOccupation> .

iscarb-career:student a owl:ObjectProperty ;
  rdfs:domain iscarb-career:CareerMapping ;
  rdfs:range <https://iscarb.edu/ontology/core/Student> .

