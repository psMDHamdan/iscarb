### SHACL Validation Version 1.0.0 ###

iscarb-finance:EquityLedgerShape a sh:NodeShape ;
  sh:targetClass :EquityLedger ;
  sh:property [
    sh:path :id ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path :studentId ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path :estimatedValue ;
    sh:minCount 1 ;
    sh:datatype xsd:float ;
  ] ;
  sh:property [
    sh:path :equityScore ;
    sh:minCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path :learningHours ;
    sh:minCount 1 ;
    sh:datatype xsd:float ;
  ] ;
  sh:property [
    sh:path :projectsScore ;
    sh:minCount 1 ;
    sh:datatype xsd:float ;
  ] ;
  sh:property [
    sh:path :challengesScore ;
    sh:minCount 1 ;
    sh:datatype xsd:float ;
  ] ;
  sh:property [
    sh:path :skillsCount ;
    sh:minCount 1 ;
    sh:datatype xsd:integer ;
  ] ;
  sh:property [
    sh:path :breakdownJson ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path :updatedAt ;
    sh:minCount 1 ;
    sh:datatype xsd:dateTime ;
  ] ;
  sh:property [
    sh:path :createdAt ;
    sh:minCount 1 ;
    sh:datatype xsd:dateTime ;
  ] ;
  sh:property [
    sh:path :universityId ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path :events ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
  ] .

