[PrefixDeclaration]
:		https://iscarb.edu/ontology/career/
iscarb-career:	https://iscarb.edu/ontology/career/
xsd:		http://www.w3.org/2001/XMLSchema#
owl:		http://www.w3.org/2002/07/owl#
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:		http://www.w3.org/2000/01/rdf-schema#

[MappingDeclaration] @collection [[
mappingId	careermapping-mapping
target		iscarb-career:careermapping/{id} a iscarb-career:CareerMapping ; iscarb-career:id {id} ; iscarb-career:studentId {studentId} ; iscarb-career:generatedTitle {generatedTitle} ; iscarb-career:titleAr {titleAr} ; iscarb-career:cluster {cluster} ; iscarb-career:sscoCode {sscoCode} ; iscarb-career:iscoMajorGroup {iscoMajorGroup} ; iscarb-career:alignment {alignment} ; iscarb-career:matchScore {matchScore} ; iscarb-career:skillsEvidence {skillsEvidence} ; iscarb-career:createdAt {createdAt} .
source		SELECT "id", "studentId", "generatedTitle", "titleAr", "cluster", "sscoCode", "iscoMajorGroup", "alignment", "matchScore", "skillsEvidence", "createdAt" FROM "CareerMapping"

mappingId	careermapping-has-ssco
target		iscarb-career:careermapping/{id} iscarb-career:ssco <https://iscarb.edu/ontology/core/ssccooccupation/{sscoCode}> .
source		SELECT "id", "sscoCode" FROM "CareerMapping" WHERE "sscoCode" IS NOT NULL

mappingId	careermapping-has-student
target		iscarb-career:careermapping/{id} iscarb-career:student <https://iscarb.edu/ontology/core/student/{studentId}> .
source		SELECT "id", "studentId" FROM "CareerMapping" WHERE "studentId" IS NOT NULL

mappingId	careerpath-mapping
target		iscarb-career:careerpath/{id} a iscarb-career:CareerPath ; iscarb-career:id {id} ; iscarb-career:studentId {studentId} ; iscarb-career:titleEn {titleEn} ; iscarb-career:titleAr {titleAr} ; iscarb-career:targetSscoCode {targetSscoCode} ; iscarb-career:targetComposite {targetComposite} ; iscarb-career:rationaleEn {rationaleEn} ; iscarb-career:rationaleAr {rationaleAr} ; iscarb-career:source {source} ; iscarb-career:model {model} ; iscarb-career:createdAt {createdAt} .
source		SELECT "id", "studentId", "titleEn", "titleAr", "targetSscoCode", "targetComposite", "rationaleEn", "rationaleAr", "source", "model", "createdAt" FROM "CareerPath"

mappingId	careerpath-has-student
target		iscarb-career:careerpath/{id} iscarb-career:student <https://iscarb.edu/ontology/core/student/{studentId}> .
source		SELECT "id", "studentId" FROM "CareerPath" WHERE "studentId" IS NOT NULL

mappingId	careerstage-mapping
target		iscarb-career:careerstage/{id} a iscarb-career:CareerStage ; iscarb-career:id {id} ; iscarb-career:pathId {pathId} ; iscarb-career:order {order} ; iscarb-career:titleEn {titleEn} ; iscarb-career:titleAr {titleAr} ; iscarb-career:focusEn {focusEn} ; iscarb-career:focusAr {focusAr} ; iscarb-career:activitiesJson {activitiesJson} ; iscarb-career:targetComposite {targetComposite} .
source		SELECT "id", "pathId", "order", "titleEn", "titleAr", "focusEn", "focusAr", "activitiesJson", "targetComposite" FROM "CareerStage"

mappingId	careerstage-has-path
target		iscarb-career:careerstage/{id} iscarb-career:path <https://iscarb.edu/ontology/core/careerpath/{pathId}> .
source		SELECT "id", "pathId" FROM "CareerStage" WHERE "pathId" IS NOT NULL

mappingId	jobposting-mapping
target		iscarb-career:jobposting/{id} a iscarb-career:JobPosting ; iscarb-career:id {id} ; iscarb-career:title {title} ; iscarb-career:titleAr {titleAr} ; iscarb-career:description {description} ; iscarb-career:employer {employer} ; iscarb-career:sector {sector} ; iscarb-career:industry {industry} ; iscarb-career:sscoCode {sscoCode} ; iscarb-career:minComposite {minComposite} ; iscarb-career:skillsJson {skillsJson} ; iscarb-career:skills {skills} ; iscarb-career:salaryMin {salaryMin} ; iscarb-career:salaryMax {salaryMax} ; iscarb-career:currency {currency} ; iscarb-career:jobType {jobType} ; iscarb-career:location {location} ; iscarb-career:remote {remote} ; iscarb-career:vision2030 {vision2030} ; iscarb-career:status {status} ; iscarb-career:views {views} ; iscarb-career:source {source} ; iscarb-career:externalId {externalId} ; iscarb-career:postedAt {postedAt} ; iscarb-career:deadline {deadline} ; iscarb-career:closedAt {closedAt} ; iscarb-career:createdAt {createdAt} ; iscarb-career:updatedAt {updatedAt} ; iscarb-career:recruiterId {recruiterId} .
source		SELECT "id", "title", "titleAr", "description", "employer", "sector", "industry", "sscoCode", "minComposite", "skillsJson", "skills", "salaryMin", "salaryMax", "currency", "jobType", "location", "remote", "vision2030", "status", "views", "source", "externalId", "postedAt", "deadline", "closedAt", "createdAt", "updatedAt", "recruiterId" FROM "JobPosting"

mappingId	jobposting-has-recruiter
target		iscarb-career:jobposting/{id} iscarb-career:recruiter <https://iscarb.edu/ontology/core/recruiter/{recruiterId}> .
source		SELECT "id", "recruiterId" FROM "JobPosting" WHERE "recruiterId" IS NOT NULL

mappingId	jobposting-has-ssco
target		iscarb-career:jobposting/{id} iscarb-career:ssco <https://iscarb.edu/ontology/core/ssccooccupation/{sscoCode}> .
source		SELECT "id", "sscoCode" FROM "JobPosting" WHERE "sscoCode" IS NOT NULL

mappingId	jobmatch-mapping
target		iscarb-career:jobmatch/{id} a iscarb-career:JobMatch ; iscarb-career:id {id} ; iscarb-career:studentId {studentId} ; iscarb-career:jobId {jobId} ; iscarb-career:matchScore {matchScore} ; iscarb-career:sscoScore {sscoScore} ; iscarb-career:compositeScore {compositeScore} ; iscarb-career:skillsScore {skillsScore} ; iscarb-career:vision2030Bonus {vision2030Bonus} ; iscarb-career:breakdownJson {breakdownJson} ; iscarb-career:computedAt {computedAt} .
source		SELECT "id", "studentId", "jobId", "matchScore", "sscoScore", "compositeScore", "skillsScore", "vision2030Bonus", "breakdownJson", "computedAt" FROM "JobMatch"

mappingId	jobmatch-has-job
target		iscarb-career:jobmatch/{id} iscarb-career:job <https://iscarb.edu/ontology/core/jobposting/{jobId}> .
source		SELECT "id", "jobId" FROM "JobMatch" WHERE "jobId" IS NOT NULL

mappingId	jobmatch-has-student
target		iscarb-career:jobmatch/{id} iscarb-career:student <https://iscarb.edu/ontology/core/student/{studentId}> .
source		SELECT "id", "studentId" FROM "JobMatch" WHERE "studentId" IS NOT NULL

mappingId	recruiter-mapping
target		iscarb-career:recruiter/{id} a iscarb-career:Recruiter ; iscarb-career:id {id} ; iscarb-career:userId {userId} ; iscarb-career:name {name} ; iscarb-career:email {email} ; iscarb-career:employer {employer} ; iscarb-career:employerLogo {employerLogo} ; iscarb-career:title {title} ; iscarb-career:status {status} ; iscarb-career:preferences {preferences} ; iscarb-career:verified {verified} ; iscarb-career:createdAt {createdAt} .
source		SELECT "id", "userId", "name", "email", "employer", "employerLogo", "title", "status", "preferences", "verified", "createdAt" FROM "Recruiter"

mappingId	recruiteractivity-mapping
target		iscarb-career:recruiteractivity/{id} a iscarb-career:RecruiterActivity ; iscarb-career:id {id} ; iscarb-career:recruiterId {recruiterId} ; iscarb-career:studentId {studentId} ; iscarb-career:action {action} ; iscarb-career:metadataJson {metadataJson} ; iscarb-career:createdAt {createdAt} .
source		SELECT "id", "recruiterId", "studentId", "action", "metadataJson", "createdAt" FROM "RecruiterActivity"

mappingId	recruiteractivity-has-recruiter
target		iscarb-career:recruiteractivity/{id} iscarb-career:recruiter <https://iscarb.edu/ontology/core/recruiter/{recruiterId}> .
source		SELECT "id", "recruiterId" FROM "RecruiterActivity" WHERE "recruiterId" IS NOT NULL

