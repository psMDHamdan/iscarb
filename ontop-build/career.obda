target		iscarb-career:recruiteractivity/{id} iscarb-career:student <https://iscarb.edu/ontology/core/student/{studentId}> .
source		SELECT "id", "studentId" FROM "RecruiterActivity" WHERE "studentId" IS NOT NULL

mappingId	careercard-mapping
target		iscarb-career:careercard/{id} a iscarb-career:CareerCard ; iscarb-career:id {id} ; iscarb-career:slug {slug} ; iscarb-career:titleEn {titleEn} ; iscarb-career:titleAr {titleAr} ; iscarb-career:employer {employer} ; iscarb-career:sector {sector} ; iscarb-career:sscoCode {sscoCode} ; iscarb-career:cluster {cluster} ; iscarb-career:dayInLifeEn {dayInLifeEn} ; iscarb-career:dayInLifeAr {dayInLifeAr} ; iscarb-career:skillsJson {skillsJson} ; iscarb-career:salaryRangeSAR {salaryRangeSAR} ; iscarb-career:vision2030 {vision2030} ; iscarb-career:demandIndex {demandIndex} ; iscarb-career:createdAt {createdAt} .
