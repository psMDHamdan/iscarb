target		iscarb-career:jobopening/{id} a iscarb-career:JobOpening ; iscarb-career:id {id} ; iscarb-career:employerId {employerId} ; iscarb-career:employer {employer} ; iscarb-career:title {title} ; iscarb-career:description {description} ; iscarb-career:requiredCompetencies {requiredCompetencies} ; iscarb-career:salaryMin {salaryMin} ; iscarb-career:salaryMax {salaryMax} ; iscarb-career:location {location} ; iscarb-career:status {status} ; iscarb-career:focusAreasJson {focusAreasJson} ; iscarb-career:createdAt {createdAt} ; iscarb-career:updatedAt {updatedAt} .
