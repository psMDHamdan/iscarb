target		iscarb-career:careercard/{id} iscarb-career:ssco <https://iscarb.edu/ontology/core/ssccooccupation/{sscoCode}> .
source		SELECT "id", "sscoCode" FROM "CareerCard" WHERE "sscoCode" IS NOT NULL

mappingId	careerinterest-mapping
target		iscarb-career:careerinterest/{id} a iscarb-career:CareerInterest ; iscarb-career:id {id} ; iscarb-career:studentId {studentId} ; iscarb-career:cardId {cardId} ; iscarb-career:status {status} ; iscarb-career:createdAt {createdAt} .
