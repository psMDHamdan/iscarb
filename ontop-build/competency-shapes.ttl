### SHACL Validation Version 1.0.0 ###

iscarb-competency:SkillExplorationShape a sh:NodeShape ;
  sh:targetClass :SkillExploration ;
  sh:property [
    sh:path :id ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path :studentId ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path :skillName ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path :sscoCode ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path :status ;
    sh:minCount 1 ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path :notes ;
    sh:datatype xsd:string ;
  ] ;
  sh:property [
    sh:path :discoveredAt ;
    sh:minCount 1 ;
    sh:datatype xsd:dateTime ;
  ] ;
  sh:property [
    sh:path :updatedAt ;
    sh:minCount 1 ;
    sh:datatype xsd:dateTime ;
  ] .

