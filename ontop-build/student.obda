mappingId	studentlearningprofile-has-student
target		iscarb-student:studentlearningprofile/{id} iscarb-student:student <https://iscarb.edu/ontology/core/student/{studentId}> .
source		SELECT "id", "studentId" FROM "StudentLearningProfile" WHERE "studentId" IS NOT NULL

mappingId	studentgoal-mapping
target		iscarb-student:studentgoal/{id} a iscarb-student:StudentGoal ; iscarb-student:id {id} ; iscarb-student:universityId {universityId} ; iscarb-student:studentId {studentId} ; iscarb-student:title {title} ; iscarb-student:description {description} ; iscarb-student:category {category} ; iscarb-student:status {status} ; iscarb-student:priority {priority} ; iscarb-student:progress {progress} ; iscarb-student:targetDate {targetDate} ; iscarb-student:completedAt {completedAt} ; iscarb-student:milestones {milestones} ; iscarb-student:relatedCompetencies {relatedCompetencies} ; iscarb-student:createdAt {createdAt} ; iscarb-student:updatedAt {updatedAt} .
source		SELECT "id", "universityId", "studentId", "title", "description", "category", "status", "priority", "progress", "targetDate", "completedAt", "milestones", "relatedCompetencies", "createdAt", "updatedAt" FROM "StudentGoal"

mappingId	studentgoal-has-student
target		iscarb-student:studentgoal/{id} iscarb-student:student <https://iscarb.edu/ontology/core/student/{studentId}> .
source		SELECT "id", "studentId" FROM "StudentGoal" WHERE "studentId" IS NOT NULL

mappingId	studentachievement-mapping
target		iscarb-student:studentachievement/{id} a iscarb-student:StudentAchievement ; iscarb-student:id {id} ; iscarb-student:universityId {universityId} ; iscarb-student:studentId {studentId} ; iscarb-student:title {title} ; iscarb-student:description {description} ; iscarb-student:category {category} ; iscarb-student:badgeIcon {badgeIcon} ; iscarb-student:rarity {rarity} ; iscarb-student:progress {progress} ; iscarb-student:requirement {requirement} .
