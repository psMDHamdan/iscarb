target		iscarb-ai:airequestlog/{id} a iscarb-ai:AiRequestLog ; iscarb-ai:id {id} ; iscarb-ai:userId {userId} ; iscarb-ai:modelId {modelId} ; iscarb-ai:prompt {prompt} ; iscarb-ai:response {response} ; iscarb-ai:tokensInput {tokensInput} ; iscarb-ai:tokensOutput {tokensOutput} ; iscarb-ai:cost {cost} ; iscarb-ai:latencyMs {latencyMs} ; iscarb-ai:status {status} ; iscarb-ai:errorMessage {errorMessage} ; iscarb-ai:metadata {metadata} ; iscarb-ai:createdAt {createdAt} .
