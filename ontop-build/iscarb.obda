target		iscarb-ai:maintenancelog/{id} a iscarb-ai:MaintenanceLog ; iscarb-ai:id {id} ; iscarb-ai:assetId {assetId} ; iscarb-ai:type {type} ; iscarb-ai:description {description} ; iscarb-ai:cost {cost} ; iscarb-ai:scheduledDate {scheduledDate} ; iscarb-ai:completedDate {completedDate} ; iscarb-ai:status {status} ; iscarb-ai:assignedTo {assignedTo} ; iscarb-ai:createdAt {createdAt} .
