@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

### Ontology Version 1.0.0 ###

### Class: EquityLedger
iscarb-finance:EquityLedger a owl:Class ;
  rdfs:label "EquityLedger" .

iscarb-finance:id a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:studentId a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:estimatedValue a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:equityScore a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:learningHours a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:projectsScore a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:challengesScore a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:skillsCount a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:breakdownJson a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:updatedAt a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:createdAt a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:universityId a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:events a owl:DatatypeProperty ;
  rdfs:domain iscarb-finance:EquityLedger .

iscarb-finance:student a owl:ObjectProperty ;
  rdfs:domain iscarb-finance:EquityLedger ;
  rdfs:range <https://iscarb.edu/ontology/core/Student> .

