[PrefixDeclaration]
:		https://iscarb.edu/ontology/ai/
iscarb-ai:	https://iscarb.edu/ontology/ai/
xsd:		http://www.w3.org/2001/XMLSchema#
owl:		http://www.w3.org/2002/07/owl#
rdf:		http://www.w3.org/1999/02/22-rdf-syntax-ns#
rdfs:		http://www.w3.org/2000/01/rdf-schema#

[MappingDeclaration] @collection [[
mappingId	aiprompt-mapping
target		iscarb-ai:aiprompt/{id} a iscarb-ai:AiPrompt ; iscarb-ai:id {id} ; iscarb-ai:unitId {unitId} ; iscarb-ai:stage {stage} ; iscarb-ai:modelTag {modelTag} ; iscarb-ai:systemPrompt {systemPrompt} ; iscarb-ai:userTemplate {userTemplate} ; iscarb-ai:temperature {temperature} ; iscarb-ai:createdAt {createdAt} .
source		SELECT "id", "unitId", "stage", "modelTag", "systemPrompt", "userTemplate", "temperature", "createdAt" FROM "AiPrompt"

mappingId	aiprompt-has-unit
target		iscarb-ai:aiprompt/{id} iscarb-ai:unit <https://iscarb.edu/ontology/core/unit/{unitId}> .
source		SELECT "id", "unitId" FROM "AiPrompt" WHERE "unitId" IS NOT NULL

mappingId	emailverification-mapping
target		iscarb-ai:emailverification/{id} a iscarb-ai:EmailVerification ; iscarb-ai:id {id} ; iscarb-ai:userId {userId} ; iscarb-ai:email {email} ; iscarb-ai:tokenHash {tokenHash} ; iscarb-ai:expiresAt {expiresAt} ; iscarb-ai:used {used} ; iscarb-ai:createdAt {createdAt} .
source		SELECT "id", "userId", "email", "tokenHash", "expiresAt", "used", "createdAt" FROM "EmailVerification"

mappingId	maintenancelog-mapping
target		iscarb-ai:maintenancelog/{id} a iscarb-ai:MaintenanceLog ; iscarb-ai:id {id} ; iscarb-ai:assetId {assetId} ; iscarb-ai:type {type} ; iscarb-ai:description {description} ; iscarb-ai:cost {cost} ; iscarb-ai:scheduledDate {scheduledDate} ; iscarb-ai:completedDate {completedDate} ; iscarb-ai:status {status} ; iscarb-ai:assignedTo {assignedTo} ; iscarb-ai:createdAt {createdAt} .
source		SELECT "id", "assetId", "type", "description", "cost", "scheduledDate", "completedDate", "status", "assignedTo", "createdAt" FROM "MaintenanceLog"

mappingId	maintenancelog-has-asset
target		iscarb-ai:maintenancelog/{id} iscarb-ai:asset <https://iscarb.edu/ontology/core/asset/{assetId}> .
source		SELECT "id", "assetId" FROM "MaintenanceLog" WHERE "assetId" IS NOT NULL

mappingId	airequestlog-mapping
target		iscarb-ai:airequestlog/{id} a iscarb-ai:AiRequestLog ; iscarb-ai:id {id} ; iscarb-ai:userId {userId} ; iscarb-ai:modelId {modelId} ; iscarb-ai:prompt {prompt} ; iscarb-ai:response {response} ; iscarb-ai:tokensInput {tokensInput} ; iscarb-ai:tokensOutput {tokensOutput} ; iscarb-ai:cost {cost} ; iscarb-ai:latencyMs {latencyMs} ; iscarb-ai:status {status} ; iscarb-ai:errorMessage {errorMessage} ; iscarb-ai:metadata {metadata} ; iscarb-ai:createdAt {createdAt} .
source		SELECT "id", "userId", "modelId", "prompt", "response", "tokensInput", "tokensOutput", "cost", "latencyMs", "status", "errorMessage", "metadata", "createdAt" FROM "AiRequestLog"

mappingId	airequestlog-has-model
target		iscarb-ai:airequestlog/{id} iscarb-ai:model <https://iscarb.edu/ontology/core/aimodel/{modelId}> .
source		SELECT "id", "modelId" FROM "AiRequestLog" WHERE "modelId" IS NOT NULL

mappingId	aimodel-mapping
target		iscarb-ai:aimodel/{id} a iscarb-ai:AiModel ; iscarb-ai:id {id} ; iscarb-ai:name {name} ; iscarb-ai:version {version} ; iscarb-ai:provider {provider} ; iscarb-ai:endpoint {endpoint} ; iscarb-ai:apiKeyEncrypted {apiKeyEncrypted} ; iscarb-ai:config {config} ; iscarb-ai:status {status} ; iscarb-ai:health {health} ; iscarb-ai:maxTokens {maxTokens} ; iscarb-ai:costPer1kInput {costPer1kInput} ; iscarb-ai:costPer1kOutput {costPer1kOutput} ; iscarb-ai:createdAt {createdAt} ; iscarb-ai:updatedAt {updatedAt} .
source		SELECT "id", "name", "version", "provider", "endpoint", "apiKeyEncrypted", "config", "status", "health", "maxTokens", "costPer1kInput", "costPer1kOutput", "createdAt", "updatedAt" FROM "AiModel"

