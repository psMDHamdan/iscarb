target		iscarb-ai:aimodelversion/{id} a iscarb-ai:AiModelVersion ; iscarb-ai:id {id} ; iscarb-ai:modelId {modelId} ; iscarb-ai:version {version} ; iscarb-ai:config {config} ; iscarb-ai:isActive {isActive} ; iscarb-ai:createdAt {createdAt} .
source		SELECT "id", "modelId", "version", "config", "isActive", "createdAt" FROM "AiModelVersion"

