# ─── Lecture Ingestion — Object Storage + OCR sidecar (TASK-02) ───
LECTURE_STORAGE_BUCKET=iscarb-lecture-files
LECTURE_STORAGE_REGION=me-central-1
# Set these to real credentials for live uploads (uncomment):
# LECTURE_STORAGE_ACCESS_KEY=
# LECTURE_STORAGE_SECRET_KEY=
LECTURE_STORAGE_PREFIX=lecture
LECTURE_OCR_URL=http://localhost:8765/ocr

# ─── Exam content source ────────────────────────────────────────────────
# false = serve the 47 questions instantly from the published Question Bank
#         (universal + specialty Job-Fit), catalog fallback for gaps. No AI at
#         exam time -> instant load.
# true  = live per-student AI generation (5-10 min first load, in-memory cache).
EXAM_LIVE_GENERATION=true
# Puppeteer/PDF rendering uses the system Chrome (html-pdf-node requires an executablePath)
PUPPETEER_EXECUTABLE_PATH=/usr/bin/google-chrome
