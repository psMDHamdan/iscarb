import { NextRequest, NextResponse } from "next/server";
import { studentToJSONLD } from "@/lib/assessment/rdf-mapper";

export async function GET(
  req: NextRequest,
  { params }: { params: { id: string } }
) {
  try {
    const studentId = params.id;
    if (!studentId) {
      return NextResponse.json({ error: "Missing student id" }, { status: 400 });
    }

    const url = new URL(req.url);
    const baseUrl = `${url.protocol}//${url.host}`;

    const jsonld = await studentToJSONLD(studentId, baseUrl);

    if (!jsonld) {
      return NextResponse.json({ error: "Student not found or missing profile" }, { status: 404 });
    }

    return new NextResponse(JSON.stringify(jsonld, null, 2), {
      status: 200,
      headers: {
        "Content-Type": "application/ld+json",
        // Enable CORS if other institutions need to fetch this
        "Access-Control-Allow-Origin": "*",
        "Access-Control-Allow-Methods": "GET",
      }
    });

  } catch (error) {
    console.error("RDF Export Error:", error);
    return NextResponse.json(
      { error: "Internal Server Error" },
      { status: 500 }
    );
  }
}
